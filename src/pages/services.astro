---
import SiteLayout from '../layouts/SiteLayout.astro';
import { serviceCategories, serviceFlow } from '../data/services';
import { sitePath } from '../utils/site-path';

const flowServices = serviceFlow
  .map((slug) => serviceCategories.find((service) => service.slug === slug))
  .filter((service) => service !== undefined);
---

<SiteLayout
  title="服務流程｜LAB2PUB2MKT"
  description="從研究設計、成果轉譯、智財與產品驗證，到市場進入；每個流程節點都可深入查看對應服務。"
>
  <header class="page-hero">
    <div>
      <p class="eyebrow">服務路徑 / 研究到應用</p>
      <h1>由研究問題，逐步走向應用。</h1>
      <p class="lede">沿著流程圖點選目前最需要的服務；每個節點都有卡點、服務方向、可能步驟與交付物說明。</p>
    </div>
    <p class="page-hero-aside">這是可調整的探索路徑，不是必須線性完成的固定流程。跨領域協作可在不同階段加入。</p>
  </header>

  <section class="section service-flow-section" aria-label="可點選的服務流程圖">
    <ol class="service-flow">
      {flowServices.map((service, index) => (
        <li class:list={{ 'service-flow-crosscut': service.slug === 'interdisciplinary-collaboration-innovation-solutions' }}>
          <span class="service-flow-marker" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <a class="service-flow-card" href={sitePath(`/services/${service.slug}/`)}>
            <span class="service-flow-meta">流程 {String(index + 1).padStart(2, '0')} <span>分類 {service.number}</span></span>
            <span class="service-flow-copy">
              <strong>{service.title}</strong>
              <span>{service.focus}</span>
            </span>
            <span class="service-flow-action">查看服務 <span aria-hidden="true">↗</span></span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <aside class="notice-band">
    <p>每個節點都是可討論的服務方向，不構成市場成功、技術成熟、智財或法規結果的保證。</p>
    <a class="text-link" href={sitePath('/contact/')}>了解目前聯絡資訊</a>
  </aside>
</SiteLayout>
