---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../utils/site-path';

const stages = [
  {
    id: 'stage-01',
    number: '01',
    title: '研究問題與需求探索',
    bottleneck: '研究問題清楚，使用者、使用場景或真正需要解決的問題仍不明確。',
    service: '整理研究目標與既有假設，界定可能的使用者，規劃需求訪談或桌面研究方向。',
    deliverable: '問題定義摘要、利害關係人初步地圖、待驗證問題清單。',
    next: '選定一項最關鍵的需求假設，確認要訪談或查證的對象與方式。',
  },
  {
    id: 'stage-02',
    number: '02',
    title: '研究證據與應用情境',
    bottleneck: '成果、方法與限制分散在論文、簡報或實驗紀錄中，不容易轉成清楚的應用主張。',
    service: '盤點研究證據、成熟度與尚未回答的問題，並將技術能力對照可能的使用情境。',
    deliverable: '證據與限制摘要、應用情境圖、需要補強的資料清單。',
    next: '依目標用途檢視關鍵證據缺口，決定先補研究、找合作方或進行可行性測試。',
  },
  {
    id: 'stage-03',
    number: '03',
    title: '利害關係人與價值探索',
    bottleneck: '技術亮點已有描述，採用者、決策者與現行替代方案還未釐清。',
    service: '整理使用者、付費者、導入者及可能合作方的角色，檢視替代方案與採用阻力。',
    deliverable: '角色關係圖、價值主張草稿、採用條件與風險清單。',
    next: '與關鍵角色核對問題與價值描述，保留證據不足或仍待訪談的部分。',
  },
  {
    id: 'stage-04',
    number: '04',
    title: '市場假設與驗證規劃',
    bottleneck: '想像中的市場機會尚未轉成可檢驗的假設，容易過早投入開發或承諾。',
    service: '把需求、採用、支付與交付條件寫成假設，安排低成本的訪談或概念測試。',
    deliverable: '假設清單、驗證問題與方法、觀察指標及判讀條件草稿。',
    next: '先執行風險最高、成本最低的一項驗證，再依觀察結果修正方向。',
  },
  {
    id: 'stage-05',
    number: '05',
    title: '合作路徑與行動整理',
    bottleneck: '研究、智財、法規、資源或合作條件彼此牽動，難以決定先後順序。',
    service: '彙整已知條件與待確認事項，辨識可能的合作路徑及需要諮詢的專業角色。',
    deliverable: '階段路線圖、決策檢核點、合作需求與待辦清單。',
    next: '由相關權責人確認路線假設；涉及智財、法規或投資判斷時，另請合格專業人士評估。',
  },
];
---

<SiteLayout
  title="服務｜LAB2PUB2MKT 研究轉譯"
  description="依研究轉譯階段整理常見瓶頸、可進行的服務、預期交付物與建議的下一步。"
>
  <header class="page-hero">
    <div>
      <p class="eyebrow">服務路徑 / 研究到應用</p>
      <h1>把下一步，拆解清楚。</h1>
      <p class="lede">每個階段先看見瓶頸，再選擇合適的工作與交付物。不預設所有研究都要走向創業或商業化。</p>
    </div>
    <p class="page-hero-aside">以下為可討論的工作架構。實際範圍、時程與交付內容，仍需依研究領域與合作條件確認。</p>
  </header>

  <section class="section" aria-label="研究轉譯階段">
    {stages.map((stage) => (
      <article class="service-stage" id={stage.id}>
        <div>
          <span class="service-index">階段 {stage.number}</span>
          <h2>{stage.title}</h2>
        </div>
        <div class="service-details">
          <div><h3>常見瓶頸</h3><p>{stage.bottleneck}</p></div>
          <div><h3>可進行的服務</h3><p>{stage.service}</p></div>
          <div><h3>預期交付物</h3><p>{stage.deliverable}</p></div>
          <div><h3>建議下一步</h3><p>{stage.next}</p></div>
        </div>
      </article>
    ))}
  </section>

  <aside class="notice-band">
    <p>研究轉譯是整理問題與證據的過程，不構成市場成功、技術成熟、智財或法規結果的保證。</p>
    <a class="text-link" href={sitePath('/contact/')}>了解目前聯絡資訊</a>
  </aside>
</SiteLayout>