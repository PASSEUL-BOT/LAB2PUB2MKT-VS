---
import SiteLayout from '../layouts/SiteLayout.astro';
import { sitePath } from '../utils/site-path';

const categories = [
  {
    number: '01',
    title: 'Research Translation & Commercialization',
    focus: '學術成果轉化、研究成果商業化、產學合作',
  },
  {
    number: '02',
    title: 'Research Design & Development',
    focus: '研究問題釐清、研究設計、研究計畫落實',
  },
  {
    number: '03',
    title: 'Intellectual Property & Technology Transfer',
    focus: '智慧財產權、技術移轉、技術授權',
  },
  {
    number: '04',
    title: 'Product Innovation & Development',
    focus: '產品創新、產品開發、概念驗證',
  },
  {
    number: '05',
    title: 'Market Discovery & Opportunity Validation',
    focus: '市場探索、需求驗證、競品分析、商業機會評估',
  },
  {
    number: '06',
    title: 'Business Model & Go-to-Market',
    focus: '商業模式設計、商業策略、市場進入與推廣',
  },
  {
    number: '07',
    title: 'Interdisciplinary Collaboration & Innovation Solutions',
    focus: '跨領域整合、專業協作、跨界創新與整合式解決方案',
  },
];
---

<SiteLayout
  title="FEATURED CASES｜服務分類｜LAB2PUB2MKT"
  description="從研究設計、技術移轉到市場驗證與商業化，了解 LAB2PUB2MKT 的七項服務分類。"
>
  <header class="page-hero">
    <div>
      <p class="eyebrow">FEATURED CASES / 服務分類</p>
      <h1>從研究成果，找到走向應用的路徑。</h1>
      <p class="lede">依研究到商業化的不同關卡，整理可提供的服務方向。</p>
    </div>
    <p class="page-hero-aside">以下是服務分類，不代表已完成的客戶案例或實際成果。真實案例會在取得公開授權後加入。</p>
  </header>

  <section class="section" aria-label="七項精選服務分類">
    <div class="case-grid">
      {categories.map((category) => (
        <article class="case-item case-category">
          <div class="case-meta"><span>分類 {category.number}</span><span>服務方向</span></div>
          <h2>{category.title}</h2>
          <p>{category.focus}</p>
        </article>
      ))}
    </div>
    <div class="draft-disclaimer">
      <p>本頁整理的是服務分類，尚未呈現可公開的實際客戶案例、成果數據或合作背書。</p>
      <a class="text-link" href={sitePath('/services/')}>查看各研究階段的瓶頸與服務流程</a>
    </div>
  </section>
</SiteLayout>

<style>
  .case-category {
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .case-category h2 {
    overflow-wrap: anywhere;
  }

  .case-category p {
    max-width: 48ch;
  }
</style>
